<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.nvpowerd-macos</string>
  <key>ProgramArguments</key><array>
    <string>/Library/PrivilegedHelperTools/nvpowerd-macos</string>
    <string>--serve</string><string>--watts</string><string>@WATTS@</string>
    <string>--rm-version</string><string>@RM_VERSION@</string>
  </array>
  <key>UserName</key><string>root</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>/var/log/nvpowerd-macos.log</string>
  <key>StandardErrorPath</key><string>/var/log/nvpowerd-macos.log</string>
</dict></plist>
